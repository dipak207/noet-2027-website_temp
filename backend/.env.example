# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Supabase PostgreSQL
# Prefer Supabase Shared Pooler session-mode connection for a persistent
# backend on IPv4-only infrastructure such as many hosted runtimes.
DATABASE_URL=

# Supabase Storage (S3-compatible)
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_REGION=ap-northeast-1
SUPABASE_STORAGE_ENDPOINT_URL=https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3

# Optional email configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NOET 2027 <no-reply@example.com>
